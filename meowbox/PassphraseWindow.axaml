<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="meowbox.PassphraseWindow"
        Icon="avares://meowbox/icon.ico"
        Width="360" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="16" Spacing="8">
    <TextBlock x:Name="Prompt" TextWrapping="Wrap" Opacity="0.7" />

    <TextBox x:Name="First" PasswordChar="●" PlaceholderText="Passphrase" />
    <TextBox x:Name="Second" PasswordChar="●" PlaceholderText="Confirm" />

    <TextBlock x:Name="Hint" Foreground="IndianRed" IsVisible="False" Text="Passphrases do not match." />

    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,4,0,0">
      <Button Content="Cancel" Click="Cancel" />
      <Button x:Name="Ok" Content="OK" IsDefault="True" IsEnabled="False" Click="Accept" />
    </StackPanel>
  </StackPanel>
</Window>
