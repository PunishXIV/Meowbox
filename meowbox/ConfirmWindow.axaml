<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="meowbox.ConfirmWindow"
        Icon="avares://meowbox/icon.ico"
        Width="320" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="16" Spacing="12">
    <TextBlock x:Name="Message" TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" Click="No" />
      <Button Content="Remove" IsDefault="True" Click="Yes" />
    </StackPanel>
  </StackPanel>
</Window>
